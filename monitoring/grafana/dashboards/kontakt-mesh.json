{
 "uid": "kontakt-mesh",
 "title": "Kontakt Mesh",
 "tags": [
  "kontakt",
  "mesh"
 ],
 "description": "Граф системы Kontakt Mesh: Master, Worker'ы, рёбра и их качество.",
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "editable": true,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "observer",
    "label": "Глазами узла",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "query_result(kontakt_mesh_observer_info)",
     "refId": "A"
    },
    "regex": "/observer=\"(?<value>[^\"]+)\".*title=\"(?<text>[^\"]+)\"/",
    "refresh": 2,
    "sort": 1,
    "includeAll": false,
    "multi": false
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "type": "row",
   "title": "Сводка",
   "collapsed": false,
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Worker'ы HEALTHY",
   "description": "Worker'ы в состоянии HEALTHY глазами наблюдателя (Master не считается).",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(kontakt_mesh_graph_node{observer=\"$observer\",detail__health=\"HEALTHY\",detail__role!=\"master\"}) or vector(0)",
     "legendFormat": "__auto",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
